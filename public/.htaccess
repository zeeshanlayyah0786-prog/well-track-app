# WELL TRACK APP - SPA fallback for Apache
# Redirects all non-file, non-directory requests to index.html so
# routes like /products, /subscription, /blog work after deployment.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
